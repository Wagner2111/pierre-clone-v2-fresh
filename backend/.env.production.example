# Production Environment Variables

PORT=5000
NODE_ENV=production

# Database - Railway fornecerá um caminho persistente
DATABASE_PATH=/data/pierre.db

# JWT - IMPORTANTE: Gerar uma chave aleatória forte em produção!
JWT_SECRET=your_production_jwt_secret_here_change_this
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_production_refresh_secret_here_change_this
JWT_REFRESH_EXPIRES_IN=30d

# CORS - Adicionar domínio Vercel aqui
CORS_ORIGIN=https://your-vercel-domain.vercel.app

# Frontend URL
FRONTEND_URL=https://your-vercel-domain.vercel.app
