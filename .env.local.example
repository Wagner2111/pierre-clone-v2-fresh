# ===================================
# NEXT.JS ENVIRONMENT VARIABLES
# ===================================

# Application
NEXT_PUBLIC_APP_NAME=Pierre Clone
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===================================
# PLUGGY OPEN BANKING INTEGRATION
# ===================================

# Pluggy API Configuration (https://www.pluggy.ai)
# Get credentials at: https://dashboard.pluggy.ai
NEXT_PUBLIC_PLUGGY_CLIENT_ID=your_pluggy_client_id_here
PLUGGY_API_KEY=your_pluggy_api_key_here
PLUGGY_ENVIRONMENT=sandbox  # or 'production'

# ===================================
# NUBANK OAUTH CONFIGURATION
# ===================================

# Nubank Open Banking Credentials
# Get credentials at: https://developer.nubank.com.br
NEXT_PUBLIC_NUBANK_CLIENT_ID=27276142351691
NEXT_PUBLIC_NUBANK_AUTH_URL=https://nuapp.nubank.com.br/open-banking/authorize
NEXT_PUBLIC_PRODUCTION_REDIRECT_URI=http://localhost:3000/callback

# ===================================
# VERCEL ANALYTICS
# ===================================

NEXT_PUBLIC_VERCEL_ANALYTICS_ID=your_analytics_id_here
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# ===================================
# FEATURE FLAGS
# ===================================

NEXT_PUBLIC_ENABLE_OAUTH=true
NEXT_PUBLIC_ENABLE_PLUGGY=true
NEXT_PUBLIC_ENABLE_CHAT=true

# ===================================
# PRODUCTION CONFIGURATION
# ===================================

# Update these for production deployment
NEXT_PUBLIC_PRODUCTION_REDIRECT_URI=https://pierre-clone.vercel.app/callback
NODE_ENV=development  # or 'production'
